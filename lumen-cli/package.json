{
  "name": "lumen-cli",
  "private": true,
  "description": "Lumen is a command-line assistant that helps illuminate relevant wellness evidence and product categories from customer context",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "build": "tsc",
    "format:arrows": "pnpm convert-to-arrow .",
    "format:biome": "pnpm biome format --write .",
    "format:braces": "pnpm strip-braces .",
    "format:check": "pnpm biome check --write .",
    "format": "npm-run-all format:arrows format:braces format:biome format:check",
    "lint:biome": "pnpm biome format .",
    "lint:oxlint": "pnpm oxlint .",
    "lint": "npm-run-all lint:biome lint:oxlint lint:exports lint:functions",
    "strip-braces": "pnpm exec sg scan --rule .ast-grep/rules/strip-braces.yml -U",
    "lint:exports": "pnpm exec sg scan --rule .ast-grep/rules/no-inline-export.yml --error=no-inline-export --globs '!**/*.d.ts' .",
    "lint:functions": "pnpm exec sg scan --rule .ast-grep/rules/no-function-declaration.yml --error=no-function-declaration --globs '!**/*.d.ts' ."
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@clack/prompts": "^1.6.0",
    "arktype": "^2.2.1",
    "commander": "^15.0.0",
    "ky": "^2.0.2",
    "openai": "^6.44.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0",
    "@ast-grep/cli-linux-x64-gnu": "^0.43.0",
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.0.0",
    "convert-to-arrow": "^1.0.21",
    "npm-run-all2": "^9.0.2",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
